#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        gaming {
            bindings = <&tog 3>;
            key-positions = <39 40 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LSHFT   &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp DELETE
                          &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            bindings = <
&kp TAB  &msc SCRL_UP    &mkp RCLK       &mmv MOVE_UP    &mkp LCLK        &kp PAGE_UP      &kp KP_PLUS     &kp N7        &kp N8        &kp N9        &kp N0         &kp LBKT
&trans   &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp PAGE_DOWN    &kp KP_MINUS    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_DIVIDE  &kp RBKT
&trans   &trans          &msc SCRL_LEFT  &mkp MCLK       &msc SCRL_RIGHT  &trans           &kp UNDERSCORE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_EQUAL   &kp BSLH
                                         &trans          &trans           &trans           &trans          &trans        &trans
            >;
        };

        raise_layer {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12    &out OUT_TOG  &none         &none         &none         &none         &ext_power EP_TOG
&none   &none   &none   &none    &none    &none      &none         &none         &none         &none         &none         &studio_unlock
                        &none    &none    &none      &none         &trans        &none
            >;
        };

        gaming {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R  &kp T        &none   &kp N7  &kp N8  &kp N9  &kp N0  &none
&kp LSHFT  &kp A  &kp S  &kp D     &kp F  &kp G        &none   &kp N4  &kp N5  &kp N6  &none   &none
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B        &none   &kp N1  &kp N2  &kp N3  &none   &none
                         &kp LALT  &mo 4  &kp SPACE    &kp F5  &none   &kp F9
            >;
        };

        gaming_lower {
            bindings = <
&kp TAB  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &none           &kp C_VOL_DN    &kp C_PLAY_PAUSE    &kp C_VOLUME_UP  &none     &kp PG_UP
&kp Y    &kp U   &kp I   &kp O   &kp P   &kp N     &none           &kp C_PREV      &kp K_MUTE          &kp C_NEXT       &kp UP    &kp PG_DN
&kp G    &kp H   &kp J   &kp K   &kp L   &kp M     &kp INSERT      &none           &none               &kp LEFT         &kp DOWN  &kp RIGHT
                         &none   &trans  &none     &kp LS(INSERT)  &kp LC(INSERT)  &kp LS(LC(INSERT))
            >;
        };
    };
};
